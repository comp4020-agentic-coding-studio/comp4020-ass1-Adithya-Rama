node_modules/
dist/
.astro/
*.log

# local Playwright run artifacts (traces, screenshots) -- CI's own run isn't
# committed either, just uploaded as a workflow artifact if ever needed
test-results/
playwright-report/

# raw reference/source renders (~33MB) -- canonical for visual direction and
# for scripts/optimize-images.mjs, but local-only; the shippable derivatives
# it produces live in public/img/ and are committed.
assets/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/
