---
import "../styles/global.css";
import "../styles/button.css";
import Starfield from "../components/Starfield.astro";
import PrimaryNav from "../components/PrimaryNav.astro";
import BlackHoleOption from "../components/BlackHoleOption.astro";
import { withBase } from "../lib/base";

const stellarStats = [
  { label: "Conceptual mass", value: "~10 solar masses" },
  { label: "Approximate event horizon scale", value: "~30 km" },
  { label: "Tidal forces at horizon", value: "Extreme" },
  { label: "Likelihood of surviving horizon crossing", value: "Very poor" },
];

const supermassiveStats = [
  { label: "Conceptual mass", value: "millions of solar masses" },
  { label: "Event horizon", value: "vast" },
  { label: "Tidal forces at horizon", value: "much milder" },
  { label: "Likelihood of crossing the horizon intact", value: "possible" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FALL — One journey. Two realities.</title>
    <meta
      name="description"
      content="An interactive explainer of gravitational time dilation: an infalling astronaut and a distant Earth observer share one event and never agree on how long it took."
    />
    <link
      rel="preload"
      as="image"
      href={withBase("img/blackhole-split-earth.webp")}
      imagesrcset={`${withBase("img/blackhole-split-earth-sm.webp")} 900w, ${withBase("img/blackhole-split-earth.webp")} 1920w`}
      imagesizes="100vw"
      fetchpriority="high"
    />
  </head>
  <body>
    <div class="experience" data-scene="hero" data-testid="interaction-output">
      <div class="layer layer-bg"></div>
      <div class="layer layer-atmosphere">
        <Starfield />
      </div>
      <div class="layer layer-scene">
        <img
          class="hero-image"
          src={withBase("img/blackhole-split-earth.webp")}
          srcset={`${withBase("img/blackhole-split-earth-sm.webp")} 900w, ${withBase("img/blackhole-split-earth.webp")} 1920w`}
          sizes="100vw"
          alt="A black hole splitting starlight into a cyan stream on one side and an amber stream on the other, with Earth visible in the distance"
          fetchpriority="high"
          decoding="async"
        />
        <div class="gravity-glow" aria-hidden="true"></div>
        <div class="split-line" aria-hidden="true"></div>
        <div class="lensing-vignette" aria-hidden="true"></div>
      </div>

      <PrimaryNav />

      <div class="duality-labels" aria-hidden="true">
        <span class="duality-label duality-label-you">You</span>
        <span class="duality-label duality-label-earth">Earth observer</span>
      </div>

      <main class="layer layer-hud">
        <section class="scene scene-hero">
          <header class="hero-copy">
            <h1 class="hero-title">FALL</h1>
            <p class="hero-tagline">One journey. Two realities.</p>
            <p class="hero-narrative">
              You and Earth synchronise your clocks.<br />
              You fall into a black hole.<br />
              You will never agree on what happens next.
            </p>
          </header>

          <div class="hero-cta">
            <button type="button" class="btn btn-primary btn-pulse" data-testid="interaction">
              Begin fall
            </button>
          </div>
        </section>

        <section class="scene scene-selecting" aria-hidden="true" inert>
          <h2>Choose your black hole</h2>
          <p class="scene-question">Which one is safer to fall into?</p>
          <p class="scene-hint">Hover, focus, or select each to compare.</p>
          <p class="scene-hint" id="repeat-run-hint" hidden></p>

          <fieldset class="blackhole-choice">
            <legend class="visually-hidden">Select a black hole to fall into</legend>
            <div class="blackhole-options">
              <BlackHoleOption
                value="stellar"
                name="blackhole"
                image="img/blackhole-stellar.webp"
                alt="A tilted blue accretion disk representing a stellar-mass black hole"
                title="Stellar black hole"
                stats={stellarStats}
              />
              <BlackHoleOption
                value="supermassive"
                name="blackhole"
                image="img/blackhole-supermassive.webp"
                alt="A tilted amber accretion disk representing a supermassive black hole"
                title="Supermassive black hole"
                stats={supermassiveStats}
              />
            </div>
          </fieldset>

          <div class="hero-cta">
            <button
              type="button"
              class="btn btn-primary"
              id="start-descent"
              data-testid="start-descent"
              disabled
            >
              Start descent
            </button>
          </div>
        </section>

        <section class="scene scene-syncing" aria-hidden="true" inert>
          <h2>Synchronise your clocks</h2>
          <p class="scene-selecting-meta" id="descent-summary"></p>

          <div class="sync-stage">
            <div class="sync-side sync-side-you">
              <img
                class="sync-astronaut-arm"
                src={withBase("img/astronaut-glove.webp")}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <span class="sync-label">You</span>
              <span class="sync-clock" id="clock-you">--:--:--</span>
            </div>

            <div class="sync-connector" aria-hidden="true">
              <span class="sync-connector-line"></span>
              <span class="sync-connector-pulse"></span>
            </div>

            <div class="sync-side sync-side-earth">
              <span class="sync-label">Earth observer</span>
              <span class="sync-clock" id="clock-earth">--:--:--</span>
            </div>
          </div>

          <p class="visually-hidden" aria-live="polite" id="sync-status"></p>

          <div class="hero-cta">
            <button type="button" class="btn btn-primary" id="sync-clocks" data-testid="sync-clocks">
              Sync clocks
            </button>
            <button
              type="button"
              class="btn btn-primary"
              id="begin-descent"
              data-testid="begin-descent"
              hidden
            >
              Begin descent
            </button>
          </div>
        </section>

        <section class="scene scene-falling" aria-hidden="true" inert>
          <h2>Falling</h2>
          <p class="scene-hint" id="fall-hint">
            Scroll or drag / Arrows move / Release pauses
          </p>

          <div class="viewpoint-control">
            <button
              type="button"
              class="btn btn-primary"
              id="look-back-toggle"
              data-testid="look-back-toggle"
              aria-pressed="false"
              aria-describedby="look-back-help"
            >
              Look back: <span id="look-back-state">Off</span>
            </button>
            <p class="visually-hidden" id="look-back-help">
              Looking back shows a stylised, illustrative view of gravitational lensing toward
              Earth. It is an educational visualisation, not a physically accurate ray-traced
              simulation.
            </p>
          </div>

          <!-- The void: the descent's actual motion. The still image is texture
               underneath; the canvas above it carries the parallax, lensing,
               streaks and dust, so the scene reads as travel rather than art. -->
          <div class="fall-void-stage">
            <img
              class="fall-void-bg"
              src={withBase("img/blackhole-split.webp")}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <canvas class="fall-void" id="fall-void" aria-hidden="true"></canvas>

            <img
              class="fall-hand"
              src={withBase("img/astronaut-glove.webp")}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <div class="fall-astronaut-stack" aria-hidden="true">
              <img
                class="fall-astronaut fall-astronaut-cool"
                src={withBase("img/astronaut-reach-cool.webp")}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <img
                class="fall-astronaut fall-astronaut-warm"
                src={withBase("img/astronaut-reach-warm.webp")}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
            </div>

          </div>

          <div class="fall-centre">
            <div class="signal-track" aria-hidden="true">
              <span class="signal-track-line"></span>
              <span class="signal-pulse" id="signal-pulse"></span>
            </div>

            <div class="fall-cue" id="fall-cue">
              <button
                type="button"
                class="btn fall-cue-button"
                id="descend-control"
                data-testid="descend-control"
                aria-describedby="fall-hint"
                aria-pressed="false"
              >
                Scroll to fall
              </button>
              <span class="fall-cue-note" aria-hidden="true">Scroll · drag</span>
            </div>
          </div>

          <div class="fall-stage">
            <div class="fall-side fall-side-you">
              <span class="sync-label">You</span>
              <span class="fall-clock" id="fall-clock-you">00:00:00</span>
              <p class="fall-readout" id="fall-readout-you">Conceptual distance to horizon: 100%</p>
              <p class="fall-caption" id="fall-caption">
                Conceptual redshift ×1.0 · Tidal stress: mild
              </p>
            </div>

            <div class="fall-side fall-side-earth">
              <span class="sync-label">Earth observer</span>
              <span class="fall-clock" id="fall-clock-earth">00:00:00</span>
              <p class="fall-readout" id="fall-readout-earth">Signal: strong</p>
            </div>
          </div>

          <div class="horizon-banner" id="horizon-banner" aria-hidden="true">
            <p class="horizon-banner-title">Event Horizon</p>
            <p class="horizon-banner-subtitle">Point of no return</p>
          </div>

          <div class="horizon-crossed-panel" id="horizon-crossed-panel" aria-hidden="true" inert>
            <img
              class="horizon-crossed-bg"
              src={withBase("img/blackhole-split-astronaut.webp")}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <h3 class="horizon-crossed-heading" id="horizon-crossed-heading">Horizon crossed</h3>
            <p class="horizon-you-copy">
              Nothing happened. Your clock continues. No giant explosion. No wall. No magical
              portal.
            </p>
            <p class="horizon-earth-copy">You can no longer send a signal back.</p>
          </div>

          <div class="escape-attempt" id="escape-attempt" aria-hidden="true" inert>
            <p class="escape-lede">One last option</p>
            <div class="future-cone" aria-hidden="true">
              <svg viewBox="0 0 200 140" aria-hidden="true" focusable="false">
                <line class="cone-arrow" data-arrow="0" x1="100" y1="130" x2="100" y2="20"></line>
                <line class="cone-arrow" data-arrow="1" x1="100" y1="130" x2="100" y2="20"></line>
                <line class="cone-arrow" data-arrow="2" x1="100" y1="130" x2="100" y2="20"></line>
                <line class="cone-arrow" data-arrow="3" x1="100" y1="130" x2="100" y2="20"></line>
                <line class="cone-arrow" data-arrow="4" x1="100" y1="130" x2="100" y2="20"></line>
                <circle class="cone-origin" cx="100" cy="130" r="4"></circle>
              </svg>
            </div>
            <div class="escape-thrust-meter" aria-hidden="true">
              <span class="escape-thrust-fill"></span>
            </div>
            <p class="escape-readout" id="escape-readout">Thrust: idle · Local velocity: steady</p>
            <p class="escape-core-line" id="escape-core-line" aria-hidden="true">
              Inside the horizon, inward is not merely a direction. It is part of your future.
            </p>
            <div class="hero-cta">
              <button
                type="button"
                class="btn btn-primary"
                id="escape-control"
                data-testid="escape-control"
              >
                Fire engines
              </button>
              <button
                type="button"
                class="btn btn-primary"
                id="see-outcome"
                data-testid="see-outcome"
                hidden
              >
                See the outcome
              </button>
            </div>
          </div>

          <div class="fall-foot">
            <div class="fall-timeline">
              <span class="fall-timeline-label" aria-hidden="true">Fall timeline</span>
              <div
                class="fall-timeline-track"
                id="fall-progressbar"
                role="progressbar"
                aria-label="Descent toward the event horizon"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                aria-valuetext="0% of the way to the event horizon"
              >
                <span class="fall-timeline-fill"></span>
                <span class="fall-timeline-head"></span>
              </div>
              <ol class="fall-timeline-steps" aria-label="Fall stage">
                <li class="fall-timeline-step is-active" data-stage="approach" aria-current="step">
                  Approach
                </li>
                <li class="fall-timeline-step" data-stage="horizon">Horizon</li>
                <li class="fall-timeline-step" data-stage="interior">Interior / Tidal outcome</li>
              </ol>
            </div>

            <div class="signal-panel">
              <img
                class="signal-wave-bg"
                src={withBase("img/blackhole-split-wave.webp")}
                alt=""
                aria-hidden="true"
                loading="lazy"
                decoding="async"
              />
              <dl class="signal-stats">
                <div class="signal-stat">
                  <dt>Outgoing</dt>
                  <dd id="signal-outgoing">Idle</dd>
                </div>
                <div class="signal-stat">
                  <dt>Latency</dt>
                  <dd id="signal-latency">—</dd>
                </div>
                <div class="signal-stat">
                  <dt>Observed</dt>
                  <dd id="signal-observed">—</dd>
                </div>
                <div class="signal-stat">
                  <dt>Redshift</dt>
                  <dd id="signal-redshift">—</dd>
                </div>
                <div class="signal-stat">
                  <dt>Received</dt>
                  <dd id="signal-received">—</dd>
                </div>
              </dl>
              <button
                type="button"
                class="btn btn-primary signal-send"
                id="send-signal"
                data-testid="send-signal"
              >
                Send: I'm OK
              </button>
            </div>
          </div>

          <p class="visually-hidden" aria-live="polite" id="fall-status"></p>
          <p class="visually-hidden" aria-live="polite" id="signal-status"></p>
        </section>

        <section class="scene scene-outcome" aria-hidden="true" inert>
          <h2>Tidal forces</h2>
          <p class="scene-question">Different black holes. Different fates.</p>

          <img
            class="outcome-image"
            id="outcome-image"
            src={withBase("img/astronaut-spaghetti.webp")}
            alt=""
            loading="lazy"
            decoding="async"
          />

          <p class="outcome-headline" id="outcome-headline"></p>

          <dl class="outcome-stats">
            <div class="outcome-stat">
              <dt>Tidal stress at horizon</dt>
              <dd id="outcome-stat-tidal">—</dd>
            </div>
            <div class="outcome-stat">
              <dt>Horizon crossing</dt>
              <dd id="outcome-stat-crossing">—</dd>
            </div>
            <div class="outcome-stat">
              <dt>Interior fate</dt>
              <dd>Unavoidable</dd>
            </div>
          </dl>

          <p class="outcome-reveal">The larger black hole can be gentler at the horizon.</p>

          <p class="visually-hidden" aria-live="polite" id="outcome-status"></p>

          <div class="hero-cta">
            <button
              type="button"
              class="btn btn-primary"
              id="try-other-blackhole"
              data-testid="try-other-blackhole"
            >
              Try the other black hole
            </button>
          </div>
        </section>

        <section class="scene scene-comparison" aria-hidden="true" inert>
          <h2>Both black holes, compared</h2>
          <p class="scene-question">You've now ridden the fall into both.</p>

          <div class="comparison-pair">
            <div class="comparison-side comparison-side-stellar">
              <img
                class="comparison-image"
                src={withBase("img/astronaut-spaghetti.webp")}
                alt="An astronaut stretched into an extreme thread by severe tidal forces"
                loading="lazy"
                decoding="async"
              />
              <p class="comparison-label">Stellar</p>
              <p class="comparison-detail">Smaller horizon · stronger tidal gradient</p>
            </div>
            <div class="comparison-side comparison-side-supermassive">
              <img
                class="comparison-image"
                src={withBase("img/astronaut-reach-warm.webp")}
                alt="An astronaut mildly stretched by comparatively gentle tidal forces"
                loading="lazy"
                decoding="async"
              />
              <p class="comparison-label">Supermassive</p>
              <p class="comparison-detail">Larger horizon · weaker gradient at the horizon</p>
            </div>
          </div>

          <figure class="comparison-chart">
            <svg viewBox="0 0 220 110" role="img" aria-labelledby="comparison-chart-title">
              <title id="comparison-chart-title"
                >Conceptual tidal stress rising as each black hole's horizon is approached. Stellar
                (solid line) rises steeply; supermassive (dashed line) rises gently.</title
              >
              <line class="comparison-chart-axis" x1="10" y1="95" x2="210" y2="95"></line>
              <line class="comparison-chart-horizon" x1="170" y1="8" x2="170" y2="95"></line>
              <path class="comparison-chart-curve comparison-chart-curve-stellar" d="M10,90 C90,88 140,68 170,14"
              ></path>
              <path
                class="comparison-chart-curve comparison-chart-curve-supermassive"
                d="M10,92 C90,91 140,88 170,78"
              ></path>
            </svg>
            <p class="comparison-chart-legend" aria-hidden="true">
              <span class="comparison-chart-legend-item comparison-chart-legend-stellar">
                <span class="comparison-chart-legend-swatch"></span> Stellar
              </span>
              <span class="comparison-chart-legend-item comparison-chart-legend-supermassive">
                <span class="comparison-chart-legend-swatch"></span> Supermassive
              </span>
            </p>
            <figcaption class="comparison-chart-caption">
              Conceptual illustration, not measured data — tidal stress vs. distance to horizon.
            </figcaption>
          </figure>

          <p class="comparison-conclusion">Bigger does not necessarily mean more violent at the horizon.</p>
          <p class="comparison-detail-line">
            The horizon and the region where tidal forces destroy you are not the same thing.
          </p>

          <div class="hero-cta">
            <button
              type="button"
              class="btn btn-primary"
              id="replay-experience"
              data-testid="replay-experience"
            >
              Replay experience
            </button>
          </div>
        </section>
      </main>
    </div>

    <script>
      import "../scripts/experience";
    </script>
  </body>
</html>

<style>
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    animation: hero-drift 50s ease-in-out infinite alternate;
  }

  .gravity-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, rgb(255 255 255 / 20%), transparent 35%);
    mix-blend-mode: screen;
    animation: glow-pulse 6s ease-in-out infinite;
  }

  .split-line {
    position: absolute;
    top: 10%;
    bottom: 10%;
    left: 50%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgb(255 255 255 / 35%), transparent);
    transform: scaleY(0);
    transform-origin: center;
    animation: split-reveal 1.6s var(--ease-standard) 0.4s both;
  }

  .layer-atmosphere {
    animation: atmosphere-drift 90s linear infinite alternate;
    transition: filter var(--duration-slow) var(--ease-standard);
  }

  .duality-labels {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    z-index: var(--z-overlay);
    display: flex;
    justify-content: space-between;
    padding: 0 var(--space-lg);
    pointer-events: none;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .duality-label {
    font-size: var(--text-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .duality-label-you {
    color: var(--color-you);
    text-shadow: 0 0 12px var(--color-you-dim);
  }

  .duality-label-earth {
    color: var(--color-earth);
    text-shadow: 0 0 12px var(--color-earth-dim);
  }

  /* the duality labels sit at vertical center, which is exactly where the
     later scenes place their own content -- fade them out once we've moved
     past the hero rather than let them collide. */
  .experience:not([data-scene="hero"]) .duality-labels {
    opacity: 0;
  }

  .layer-hud {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-2xl) var(--space-md) var(--space-xl);
    text-align: center;
  }

  .scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* safe center: centers short scenes like the current `center` did, but
       falls back to start-alignment once content exceeds the viewport --
       plain `center` in a scrollable flex column lets the *top* overflow
       clip with no way to scroll up to it (browsers only grant scrollable
       overflow on the far/end side of a centered flex axis). */
    justify-content: safe center;
    gap: var(--space-lg);
    padding: var(--space-2xl) var(--space-md);
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }

  .experience[data-scene="hero"] .scene-hero,
  .experience[data-scene="selecting"] .scene-selecting,
  .experience[data-scene="syncing"] .scene-syncing,
  .experience[data-scene="falling"] .scene-falling,
  .experience[data-scene="outcome"] .scene-outcome,
  .experience[data-scene="comparison"] .scene-comparison {
    opacity: 1;
    pointer-events: auto;
  }

  .blackhole-choice {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    width: 100%;
    max-width: 44rem;
  }

  .blackhole-options {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
  }

  .scene-question {
    margin: 0;
    font-size: var(--text-body);
    color: var(--color-text-dim);
    font-weight: 400;
  }

  .scene-hint {
    margin: calc(var(--space-xs) * -1) 0 0;
    font-size: var(--text-small);
    color: var(--color-text-faint);
  }

  .viewpoint-control {
    display: flex;
    justify-content: center;
  }

  .hero-title {
    margin: 0;
    font-size: var(--text-hero);
    letter-spacing: 0.3em;
    font-weight: 400;
    color: var(--color-text);
    text-shadow: var(--glow-soft);
    animation: title-reveal 1.4s var(--ease-standard) both;
  }

  .hero-tagline {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-body);
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }

  .hero-narrative {
    margin: var(--space-md) 0 0;
    font-size: var(--text-small);
    color: var(--color-text-faint);
    line-height: 1.8;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
  }

  /* Invites the first tap, then settles -- a permanently-pulsing button is
     exactly the "distracting constant movement" the motion pass calls out to
     avoid, so this runs a few times and stops rather than looping forever. */
  .btn-pulse {
    animation: cta-pulse 2.4s ease-in-out 3;
  }

  .scene-selecting h2 {
    margin: 0;
    font-size: var(--text-h2);
    letter-spacing: 0.03em;
    color: var(--color-text);
    font-weight: 700;
  }

  .scene-selecting-meta {
    margin: 0;
    color: var(--color-text-dim);
    font-size: var(--text-small);
  }

  .sync-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    width: 100%;
    max-width: 48rem;
  }

  .sync-side {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    border: var(--border-hairline);
    background: var(--surface-glass-bg);
    backdrop-filter: blur(var(--surface-glass-blur));
  }

  .sync-side-you {
    border-color: var(--color-you-dim);
    box-shadow: var(--glow-you);
  }

  .sync-side-earth {
    border-color: var(--color-earth-dim);
    box-shadow: var(--glow-earth);
  }

  .sync-label {
    font-size: var(--text-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .sync-side-you .sync-label {
    color: var(--color-you);
  }

  .sync-side-earth .sync-label {
    color: var(--color-earth);
  }

  .sync-clock {
    font-family: var(--font-mono);
    font-size: var(--text-h2);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }

  .sync-stage.synced .sync-clock {
    animation: clock-snap 0.6s var(--ease-standard);
  }

  .sync-astronaut-arm {
    position: absolute;
    bottom: -2.5rem;
    width: 6rem;
    opacity: 0.35;
    pointer-events: none;
  }

  .sync-connector {
    position: relative;
    flex: 0 0 auto;
    width: 5rem;
    height: 2px;
  }

  .sync-connector-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--color-you-dim), var(--color-earth-dim));
    opacity: 0.4;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .sync-stage.synced .sync-connector-line {
    opacity: 1;
  }

  .sync-connector-pulse {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--color-text);
    box-shadow: var(--glow-soft);
    opacity: 0;
  }

  .sync-stage.synced .sync-connector-pulse {
    animation: connector-pulse 0.9s var(--ease-standard);
  }

  /* the lensing vignette lives on the persistent background layer, so its
     intensity (set on .experience via --fall-lensing) reaches it by plain
     custom-property inheritance -- no per-scene wiring needed. */
  .lensing-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, transparent 30%, rgb(0 0 0 / 70%) 100%);
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .experience[data-scene="falling"] .lensing-vignette {
    /* Closes in harder than the shared default: during a descent this is the
       tunnel narrowing, not a decorative edge darkening. */
    background: radial-gradient(
      circle at 50% 50%,
      transparent calc(26% - var(--fall-progress, 0) * 18%),
      rgb(0 0 0 / 88%) calc(96% - var(--fall-progress, 0) * 26%)
    );
    opacity: calc(0.25 + var(--fall-lensing, 0) * 0.75);
  }

  .experience[data-scene="falling"] .gravity-glow {
    transform: scale(calc(1 + var(--fall-lensing, 0) * 0.4));
    transition: transform var(--duration-medium) var(--ease-standard);
  }

  /* The shared hero backdrop is the Earth composition, whose hole sits
     off-centre of the 50% split line. During the descent the centred
     composition in .fall-void-bg takes over and this recedes -- except in look
     back, which is the one moment the visitor is meant to see Earth again. */
  .experience[data-scene="falling"] .hero-image {
    /* Fully out during the descent, not merely dimmed: at any visible opacity
       its off-centre hole reads as a *second* black hole beside the centred
       one, which is worse than no backdrop at all. */
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }

  /* Inside the horizon the backdrop goes calm with the canvas: dim, deeply
     redshifted, almost still. The canvas alone going quiet while the image
     stayed bright read as the motion stopping rather than the place changing. */
  .experience[data-horizon="crossed"] .fall-void-bg {
    opacity: 0.4;
    filter: saturate(0.5) brightness(0.42) hue-rotate(-18deg);
  }

  /* Beyond the horizon the cue is disabled and the overlay panels own the
     centre -- leaving it visible behind them just showed dead text. */
  .experience[data-horizon="crossed"] .fall-cue,
  .experience[data-horizon="crossing"] .fall-cue {
    opacity: 0;
    pointer-events: none;
  }

  .experience[data-scene="falling"][data-lookback="true"] .fall-void-bg {
    opacity: 0;
  }

  .experience[data-scene="falling"][data-lookback="true"] .fall-void {
    opacity: 0.35;
  }
  .experience[data-scene="falling"][data-lookback="true"] .fall-void-stage::before {
    animation: camera-turn-veil 900ms cubic-bezier(0.4, 0, 0.2, 1) both;
  }


  /* "Look back" is a viewpoint change on the persistent background layers,
     not a new scene -- toggling data-lookback off simply drops these
     overrides and the ordinary forward view (including hero-image's ambient
     drift) returns on its own. Not a literal ray trace: a stylised warp
     whose strength follows the same --fall-lensing progress driving the
     rest of the descent (see the hidden help text next to the toggle). */
  .experience[data-scene="falling"][data-lookback="true"] .hero-image {
    animation: lookback-arrive 900ms cubic-bezier(0.2, 0.75, 0.2, 1) both;
    opacity: 1;
    transform: scale(calc(1 + var(--fall-lensing, 0) * 0.6))
      translateX(calc(var(--fall-lensing, 0) * -8%));
    filter: blur(calc(var(--fall-lensing, 0) * 2px)) saturate(calc(1 + var(--fall-lensing, 0) * 0.5));
    transition:
      transform var(--duration-slow) var(--ease-standard),
      filter var(--duration-slow) var(--ease-standard);
  }

  .experience[data-scene="falling"][data-lookback="true"] .layer-atmosphere {
    filter: hue-rotate(calc(var(--fall-lensing, 0) * -20deg))
      contrast(calc(1 + var(--fall-lensing, 0) * 0.3));
  }

  /* -- the falling scene is a cockpit, not a document.
     Every other scene is a centred, scrollable column; this one is pinned to
     the viewport so the void is never pushed off-screen and the descent cue is
     never below the fold. `gap: 0` is deliberate: inheriting .scene's 40px
     inter-child gap across a dozen children is half of what produced the dead
     band this redesign removes. */
  .scene-falling {
    display: grid;
    grid-template-areas:
      "you header earth"
      "you centre earth"
      "foot foot   foot";
    grid-template-columns: minmax(0, 19rem) minmax(0, 1fr) minmax(0, 19rem);
    grid-template-rows: auto minmax(0, 1fr) auto;
    align-items: start;
    justify-content: stretch;
    gap: 0;
    /* top padding clears the fixed corner wordmark, which shares this corner
       with the YOU rail. */
    padding: var(--space-xl) var(--space-md) var(--space-md);
    overflow: hidden;
  }

  /* Everything in the cockpit sits over moving, sometimes very bright imagery,
     so the small type carries its own shadow rather than needing a scrim panel
     behind it. */
  /* The void layer is positioned, so it paints above static siblings even at
     z-index 0 -- the header cluster has to be positioned too or the canvas
     swallows it. */
  .scene-falling > h2,
  .scene-falling > .scene-hint,
  .scene-falling > .viewpoint-control {
    position: relative;
    z-index: 1;
  }

  .scene-falling > h2 {
    grid-area: header;
    align-self: start;
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    text-shadow: 0 1px 6px rgb(0 0 0 / 85%);
  }

  .scene-falling > .scene-hint {
    grid-area: header;
    align-self: start;
    margin: 1.75rem 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-text-dim);
    text-shadow: 0 1px 6px rgb(0 0 0 / 90%);
  }

  .scene-falling .fall-clock,
  .scene-falling .fall-readout,
  .scene-falling .fall-caption,
  .scene-falling .sync-label,
  .fall-timeline-label,
  .fall-timeline-step,
  .signal-stat dt,
  .signal-stat dd {
    text-shadow: 0 1px 6px rgb(0 0 0 / 90%);
  }

  .scene-falling > .viewpoint-control {
    grid-area: header;
    align-self: start;
    margin-top: 4.25rem;
  }

  /* The void spans the whole frame rather than a middle column: the reference
     puts the hole edge-to-edge with the readouts floating over it. Taken out of
     the grid flow entirely so the scene's padding can't inset it. */
  .fall-void-stage {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* A camera turn and a horizon plunge need a full-frame transition layer;
     otherwise both moments read as ordinary opacity swaps. */
  .fall-void-stage::before,
  .fall-void-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .fall-void-stage::before {
    z-index: 3;
    background:
      linear-gradient(100deg, transparent 18%, rgb(190 225 255 / 22%) 48%, transparent 76%),
      radial-gradient(circle at 50% 50%, transparent 10%, rgb(4 6 12 / 54%) 74%);
    opacity: 0;
    transform: translateX(-45%) skewX(-10deg);
  }

  .fall-void-stage::after {
    z-index: 4;
    background: radial-gradient(circle at 50% 50%, transparent 0 9%, rgb(0 0 0 / 20%) 24%, #000 72%);
    opacity: 0;

    /* Never below scale(1): the gradient is opaque past 72%, so a smaller box
       shows its own corners as a rectangle (see @keyframes horizon-engulf). */
    transform: scale(2.8);
  }

  .fall-void-bg {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
    object-fit: cover;
    opacity: 0;
    object-position: 50% 50%;
    transform: scale(calc(0.9 + var(--fall-progress, 0) * 0.72))
      rotate(calc(var(--fall-progress, 0) * 2deg));
    filter: saturate(calc(1 + var(--fall-progress, 0) * 0.5))
      brightness(calc(1 - var(--fall-progress, 0) * 0.2))
      hue-rotate(calc(var(--fall-progress, 0) * 10deg));
    transition:
      opacity var(--duration-slow) var(--ease-standard),
      transform var(--duration-medium) var(--ease-standard),
      filter var(--duration-medium) var(--ease-standard);
  }

  .experience[data-scene="falling"] .fall-void-bg {
    opacity: calc(0.78 + var(--fall-progress, 0) * 0.2);
  }

  .experience[data-horizon="crossing"] .fall-void-bg {
    animation: horizon-plunge 3.2s cubic-bezier(0.3, 0, 0.1, 1) both;
  }

  .experience[data-horizon="crossing"] .fall-void-stage::after {
    animation: horizon-engulf 3.2s cubic-bezier(0.45, 0, 0.12, 1) both;
  }

  .experience[data-horizon="crossing"] .fall-void {
    animation: void-flare 3.2s ease-in both;
  }

  .experience[data-horizon="crossed"] .fall-void-stage::after {
    opacity: 0.34;
    transform: scale(1);
  }

  /* The canvas is the movement (see src/scripts/fall-void.ts); the image above
     is texture it sits on. Pointer events are re-enabled here so drag-to-fall
     has a surface, while the rest of the visual layer stays transparent to
     clicks. */
  .fall-void {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: auto;
    touch-action: none;
    cursor: ns-resize;
  }

  .fall-centre {
    position: relative;
    z-index: 1;
    grid-area: centre;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-md);
    align-self: stretch;
    padding-bottom: var(--space-sm);
    pointer-events: none;
  }

  .fall-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xs);
    pointer-events: auto;
    opacity: 1;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }

  /* The cue is an affordance, not a demand: scroll and drag are the primary
     inputs, so once the visitor has moved at all it recedes rather than
     continuing to advertise itself. It stays focusable and operable throughout
     -- it is also the deliberate "cross the horizon" trigger. */
  .fall-cue[data-seen="true"] {
    opacity: 0.6;
  }

  .fall-cue:focus-within,
  .fall-cue:hover {
    opacity: 1;
  }

  .fall-cue-button {
    border-color: var(--color-you-dim);
    background: rgb(5 7 12 / 64%);
    color: var(--color-you-strong);
    min-width: 10rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    box-shadow: 0 0 0 1px rgb(100 220 255 / 8%), 0 0 28px rgb(60 190 255 / 10%);
  }

  .fall-cue-button:hover,
  .fall-cue-button:focus-visible {
    background: var(--color-you-dim);
    box-shadow: var(--glow-you);
  }

  .fall-cue-note {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    text-shadow: 0 1px 6px rgb(0 0 0 / 90%);
  }

  /* Once the threshold is reached the control is a deliberate "cross" action,
     so telling the visitor to keep scrolling would be actively wrong. */
  .experience[data-horizon] .fall-cue-note {
    display: none;
  }

  /* Scoped to "approaching" only: at that point pressing is the deliberate
     crossing action, so the cue comes back to full strength. The crossed and
     crossing states hide it entirely (see above). */
  .experience[data-horizon="approaching"] .fall-cue {
    opacity: 1;
  }

  /* -- rails, not cards. The old treatment put two rounded, blurred glass
     boxes over the middle of frame, covering the hole. These are hairline
     columns pinned to the top corners, with a scrim only for legibility. */
  .fall-stage {
    display: contents;
  }

  .fall-side {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    /* stretch so the two rails read as a matched pair even though the YOU side
       carries one more readout row than the EARTH side. */
    align-self: stretch;
    align-items: flex-start;
    gap: var(--space-2xs);
    width: 100%;
    padding: var(--space-xs) var(--space-sm);
    text-align: left;
  }

  .fall-side-you {
    grid-area: you;
    border-left: 2px solid var(--color-you-dim);
    background: linear-gradient(to right, rgb(5 7 12 / 76%), rgb(5 7 12 / 18%) 78%, transparent);
  }

  .fall-side-earth {
    grid-area: earth;
    align-items: flex-end;
    border-right: 2px solid var(--color-earth-dim);
    background: linear-gradient(to left, rgb(5 7 12 / 76%), rgb(5 7 12 / 18%) 78%, transparent);
    text-align: right;
  }

  .fall-side-you .sync-label {
    color: var(--color-you);
  }

  .fall-side-earth .sync-label {
    color: var(--color-earth);
  }

  .fall-clock {
    font-family: var(--font-mono);
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }

  .fall-readout {
    margin: 0;
    padding-top: var(--space-2xs);
    border-top: var(--border-hairline);
    width: 100%;
    font-size: 0.78rem;
    color: var(--color-text-dim);
  }

  /* The EARTH side warms toward red as the descent deepens, the way the
     reference's observer panel does at the horizon. */
  .fall-side-earth .fall-readout {
    color: color-mix(in srgb, var(--color-text-dim), var(--color-danger) calc(var(--fall-progress, 0) * 70%));
  }

  /* Foreground props live in the void now, not inside the readout cards: the
     glove is the visitor's own hand at the edge of frame and the astronaut is
     what Earth still sees of them, both over the scene rather than boxed. */
  .fall-hand {
    position: absolute;
    bottom: -2%;
    left: -1%;
    width: clamp(11rem, 26vw, 24rem);
    opacity: 0.5;
    pointer-events: none;
    transform: scale(calc(1 + var(--fall-lensing, 0) * 0.15))
      rotate(calc(var(--fall-progress, 0) * -3deg));
    transition: transform var(--duration-medium) var(--ease-standard);
  }

  .fall-astronaut-stack {
    position: absolute;
    top: 46%;
    right: 8%;
    width: clamp(3.5rem, 7vw, 6.5rem);
    aspect-ratio: 1;
    pointer-events: none;
    transform: translateY(-50%) scale(calc(1 - var(--fall-progress, 0) * 0.35));
    transition: transform var(--duration-medium) var(--ease-standard);
  }

  .fall-astronaut {
    position: absolute;
    inset: 0;
    width: 100%;
    border-radius: var(--radius-md);
    opacity: var(--fall-brightness, 1);
    filter: sepia(var(--fall-warmth, 0)) blur(var(--fall-motion-blur, 0px));
    transition:
      opacity var(--duration-medium) var(--ease-standard),
      filter var(--duration-medium) var(--ease-standard);
  }

  /* the warm-lit astronaut is invisible until horizon crossing begins -- it
     ignores --fall-brightness entirely and is driven purely by the
     data-horizon states below, so it never competes with the ordinary
     descent-brightness fade on the cool image above it. */
  .fall-astronaut-warm {
    opacity: 0;
  }

  /* Crossing is a scripted, discrete event (see beginCrossing/finishCrossing
     in experience.ts) rather than a continued function of `progress` --
     fall-sim.ts's formulas diverge at progress = 1, so "at the horizon" and
     "beyond it" are their own attribute states, not further points on the
     existing curves. The astronaut fades in two steps (crossing -> crossed)
     rather than vanishing outright, per "fades rather than remaining
     perfectly visible forever". */
  .experience[data-horizon="crossing"] .fall-astronaut-cool,
  .experience[data-horizon="crossed"] .fall-astronaut-cool {
    opacity: 0;
  }

  .experience[data-horizon="crossing"] .fall-astronaut-warm {
    opacity: 0.55;
  }

  .experience[data-horizon="crossed"] .fall-astronaut-warm {
    opacity: 0.1;
  }

  /* State-conditional panels are positioned overlays, not flow content.
     Hiding them with `opacity: 0` alone still reserved their full box height --
     the escape panel's cone SVG and button row alone were ~300px -- which is
     what produced the dead band between the readouts and the timeline. Taken
     out of flow they cost nothing until the state that reveals them. */
  .horizon-banner,
  .horizon-crossed-panel,
  .escape-attempt {
    position: absolute;
    z-index: 2;
    left: 50%;
    transform: translateX(-50%);
  }

  .horizon-banner {
    top: 22%;
    text-align: center;
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .experience[data-horizon="approaching"] .horizon-banner {
    opacity: 1;
  }

  .horizon-banner-title {
    margin: 0;
    font-size: var(--text-h2);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-earth-strong, var(--color-earth));
    text-shadow: var(--glow-earth);
  }

  .horizon-banner-subtitle {
    margin: var(--space-2xs) 0 0;
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  /* the crossed panel stays out of the accessibility tree (aria-hidden +
     inert) until finishCrossing() reveals it -- opacity alone would leave a
     screen reader free to announce "you can no longer send a signal back"
     before that's actually true. */
  .horizon-crossed-panel {
    top: 20%;
    width: min(34rem, 88vw);
    padding: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--color-danger);
    border-bottom: 1px solid var(--color-danger);
    background: linear-gradient(rgb(5 7 12 / 86%), rgb(5 7 12 / 72%));
    backdrop-filter: blur(14px);
    overflow: hidden;
    text-align: center;
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .experience[data-horizon="crossed"] .horizon-crossed-panel {
    opacity: 1;
  }

  .horizon-crossed-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: -1;
  }

  .horizon-crossed-heading {
    margin: 0;
    font-size: var(--text-h2);
    font-weight: 600;
    color: var(--color-text);
  }

  .horizon-you-copy {
    margin: var(--space-sm) 0 0;
    font-size: var(--text-small);
    color: var(--color-text-dim);
    line-height: 1.7;
  }

  .horizon-earth-copy {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-earth-strong, var(--color-earth));
  }

  /* The escape attempt is "one last agency moment" immediately after
     crossing -- revealed by finishCrossing() the same way the crossed panel
     is, and never shown again once spent (see attemptEscape() in
     experience.ts). The cone's five lines share one pivot (the origin dot)
     and are re-angled per data-escape state via --cone-angle, rather than
     drawn as five separate static diagrams, so the "hope, then collapse"
     read comes from one continuous shape changing, not a cut between two
     pictures. */
  .escape-attempt {
    bottom: 7rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    width: min(30rem, 90vw);
    padding: var(--space-sm) var(--space-md);
    background: linear-gradient(rgb(5 7 12 / 72%), rgb(5 7 12 / 72%));
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .experience[data-horizon="crossed"] .escape-attempt {
    opacity: 1;
  }

  .escape-lede {
    margin: 0;
    font-size: var(--text-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .future-cone {
    width: 12rem;
  }

  .future-cone svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cone-origin {
    fill: var(--color-text);
  }

  .cone-arrow {
    fill: none;
    stroke: var(--color-text-dim);
    stroke-width: 2;
    stroke-linecap: round;
    transform-box: view-box;
    transform-origin: 100px 130px;
    transform: rotate(var(--cone-angle, 0deg));
    transition:
      transform 0.6s var(--ease-standard),
      stroke var(--duration-medium) var(--ease-standard);
  }

  /* Idle/default already tells the truth (this widget only exists once
     you're inside the horizon) -- a narrow, converging fan. "Attempting"
     briefly widens it to suggest escape is on the table; "inevitable"
     returns to the same narrow geometry, recoloured, to make clear that was
     never really available. */
  .cone-arrow[data-arrow="0"] {
    --cone-angle: -8deg;
  }

  .cone-arrow[data-arrow="1"] {
    --cone-angle: -4deg;
  }

  .cone-arrow[data-arrow="3"] {
    --cone-angle: 4deg;
  }

  .cone-arrow[data-arrow="4"] {
    --cone-angle: 8deg;
  }

  .escape-attempt[data-escape="attempting"] .cone-arrow {
    stroke: var(--color-you);
    filter: drop-shadow(0 0 4px var(--color-you-dim));
  }

  .escape-attempt[data-escape="attempting"] .cone-arrow[data-arrow="0"] {
    --cone-angle: -60deg;
  }

  .escape-attempt[data-escape="attempting"] .cone-arrow[data-arrow="1"] {
    --cone-angle: -30deg;
  }

  .escape-attempt[data-escape="attempting"] .cone-arrow[data-arrow="3"] {
    --cone-angle: 30deg;
  }

  .escape-attempt[data-escape="attempting"] .cone-arrow[data-arrow="4"] {
    --cone-angle: 60deg;
  }

  .escape-attempt[data-escape="inevitable"] .cone-arrow {
    stroke: var(--color-earth-strong, var(--color-earth));
  }

  .escape-thrust-meter {
    width: 10rem;
    height: 4px;
    border-radius: 2px;
    background: rgb(255 255 255 / 12%);
    overflow: hidden;
  }

  .escape-thrust-fill {
    display: block;
    height: 100%;
    width: 8%;
    background: var(--color-text-dim);
    transition:
      width var(--duration-medium) var(--ease-standard),
      background var(--duration-medium) var(--ease-standard);
  }

  .escape-attempt[data-escape="attempting"] .escape-thrust-fill {
    width: 92%;
    background: var(--color-you);
    box-shadow: var(--glow-you);
  }

  .escape-attempt[data-escape="inevitable"] .escape-thrust-fill {
    width: 15%;
    background: var(--color-earth-strong, var(--color-earth));
  }

  .escape-readout {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-dim);
  }

  .escape-core-line {
    margin: 0;
    max-width: 24rem;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-text);
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .escape-attempt[data-escape="inevitable"] .escape-core-line {
    opacity: 1;
  }

  .fall-caption {
    margin: 0;
    padding-top: var(--space-2xs);
    border-top: var(--border-hairline);
    width: 100%;
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    color: var(--color-text-faint);
  }

  /* -- the footer: a full-width timeline across the base of frame, as in the
     reference, rather than a glass pill floating mid-column. */
  .fall-foot {
    position: relative;
    z-index: 1;
    grid-area: foot;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-self: end;
    width: 100%;
    padding-top: var(--space-2xs);
    border-top: var(--border-hairline);
  }

  .fall-timeline {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-3xs) var(--space-sm);
    width: 100%;
  }

  .fall-timeline-label {
    font-size: var(--text-label);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  /* Read-only by design: a draggable handle would advertise scrubbing, and the
     descent is expressed through input intent, not playhead position. */
  .fall-timeline-track {
    position: relative;
    height: 2px;
    background: rgb(255 255 255 / 14%);
  }

  .fall-timeline-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--fall-progress, 0) / 0.94 * 100%);
    background: linear-gradient(to right, var(--color-you), var(--color-earth));
    transition: width var(--duration-fast) var(--ease-standard);
  }

  .fall-timeline-head {
    position: absolute;
    top: 50%;
    left: calc(var(--fall-progress, 0) / 0.94 * 100%);
    width: 9px;
    height: 9px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-you-strong);
    box-shadow: var(--glow-you);
    transition: left var(--duration-fast) var(--ease-standard);
  }

  .fall-timeline-steps {
    display: flex;
    grid-column: 2;
    justify-content: space-between;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .fall-timeline-step {
    position: relative;
    padding-left: var(--space-sm);
  }

  .fall-timeline-step::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 6px;
    height: 6px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--color-text-faint);
  }

  .fall-timeline-step.is-active {
    color: var(--color-text);
  }

  .fall-timeline-step.is-active::before {
    background: var(--color-you);
    box-shadow: var(--glow-you);
  }

  .fall-timeline-step.is-complete {
    color: var(--color-text-dim);
  }

  .fall-timeline-step.is-complete::before {
    background: var(--color-you-dim);
  }

  #descend-control {
    touch-action: none;
  }

  #descend-control[aria-pressed="true"] {
    background: var(--color-you-dim);
    box-shadow: var(--glow-you);
  }

  #look-back-toggle[aria-pressed="true"] {
    background: var(--color-you-dim);
    box-shadow: var(--glow-you);
  }

  /* the "I'm OK" signal pulse travels along this track between the two
     sides -- a transition-based dot rather than a fixed keyframe animation,
     since its duration and end state have to vary with fall progress. */
  .signal-track {
    position: relative;
    flex: 0 0 auto;
    width: min(30rem, 52vw);
    height: 2px;
    margin-top: auto;
  }

  .signal-track-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--color-you-dim), var(--color-earth-dim));
    opacity: 0.25;
  }

  .signal-pulse {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--color-you);
    box-shadow: var(--glow-you);
    opacity: 0;
    transform: scaleX(1);
    transition-property: left, transform, opacity, background-color, box-shadow;
    /* Position travels at the pulse's fixed signal speed (linear = constant
       velocity), but the stretch/fade/colour shift that reads as "arriving"
       eases instead -- a mechanical linear ease on all five properties made
       the arrival feel like a slide, not a signal settling in. */
    transition-timing-function: linear, ease-out, ease-out, ease-out, ease-out;
  }

  .signal-pulse.is-armed {
    opacity: 1;
  }

  .signal-pulse.is-arriving {
    left: calc(100% - 10px);
    transform: scaleX(var(--signal-stretch, 2));
    opacity: var(--signal-arrival-opacity, 0.3);
    background: var(--color-earth);
    box-shadow: var(--glow-earth);
  }

  /* De-glassed into a quiet row of readouts along the base of the cockpit: it
     is an instrument strip, not a card floating over the hole. */
  .signal-panel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    width: 100%;
    padding: var(--space-2xs) 0 0;
    border-top: var(--border-hairline);
    overflow: hidden;
  }

  .signal-send {
    flex: 0 0 auto;
    padding: var(--space-2xs) var(--space-md);
    font-size: var(--text-label);
  }

  .signal-wave-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.12;
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: -1;
  }

  .signal-stats {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--space-3xs) var(--space-md);
    margin: 0;
    padding: 0;
  }

  .signal-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1px;
  }

  .signal-stat dt {
    margin: 0;
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .signal-stat dd {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-text-dim);
  }

  /* The outcome scene answers the trick question from the black-hole choice
     screen: tidalGain in fall-sim.ts already makes the stellar hole's tidal
     stress rise to "extreme" by MAX_FALL_PROGRESS while the supermassive
     hole's stays "mild" -- this scene just reads describeTidalStress() back,
     rather than hardcoding a second copy of that comparison. */
  .outcome-image {
    width: 8rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: var(--border-hairline);
  }

  .outcome-headline {
    margin: 0;
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--color-text);
  }

  .outcome-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 32rem;
  }

  .outcome-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .outcome-stat dt {
    margin: 0;
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .outcome-stat dd {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-text-dim);
  }

  .outcome-reveal {
    margin: 0;
    max-width: 26rem;
    font-size: var(--text-small);
    font-style: italic;
    color: var(--color-text);
  }

  /* Both variants have now been ridden, so unlike the single-outcome scene
     this has nothing left to compute per-run -- the pairing of stellar vs
     supermassive is fixed, which is why the markup above is static rather
     than JS-populated. */
  .comparison-pair {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
  }

  .comparison-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xs);
  }

  .comparison-image {
    width: 6.5rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: var(--border-hairline);
  }

  .comparison-side-stellar .comparison-image {
    box-shadow: var(--glow-you);
  }

  .comparison-side-supermassive .comparison-image {
    box-shadow: var(--glow-earth);
  }

  .comparison-label {
    margin: 0;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .comparison-detail {
    margin: 0;
    max-width: 11rem;
    font-size: var(--text-label);
    text-align: center;
    color: var(--color-text-faint);
  }

  /* A conceptual curve, not plotted data -- the figcaption says so
     explicitly per "label that clearly", so this never reads as a claim of
     measurement. */
  .comparison-chart {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xs);
    margin: 0;
    width: 100%;
    max-width: 20rem;
  }

  .comparison-chart svg {
    width: 100%;
    height: auto;
  }

  .comparison-chart-axis {
    stroke: var(--color-text-faint);
    stroke-width: 1;
  }

  .comparison-chart-horizon {
    stroke: var(--color-text-faint);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .comparison-chart-curve {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .comparison-chart-curve-stellar {
    stroke: var(--color-you);
  }

  .comparison-chart-curve-supermassive {
    stroke: var(--color-earth);
    stroke-dasharray: 6 4;
  }

  .comparison-chart-legend {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    margin: 0;
    font-size: var(--text-label);
    color: var(--color-text-dim);
  }

  .comparison-chart-legend-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .comparison-chart-legend-swatch {
    display: inline-block;
    width: 1rem;
    height: 2px;
  }

  .comparison-chart-legend-stellar .comparison-chart-legend-swatch {
    background: var(--color-you);
  }

  .comparison-chart-legend-supermassive .comparison-chart-legend-swatch {
    background-image: linear-gradient(to right, var(--color-earth) 60%, transparent 60%);
    background-size: 4px 2px;
    background-repeat: repeat-x;
  }

  .comparison-chart-caption {
    margin: 0;
    max-width: 22rem;
    font-size: var(--text-label);
    text-align: center;
    color: var(--color-text-faint);
  }

  .comparison-conclusion {
    margin: 0;
    max-width: 28rem;
    font-size: var(--text-h2);
    font-weight: 600;
    text-align: center;
    color: var(--color-text);
  }

  .comparison-detail-line {
    margin: 0;
    max-width: 26rem;
    font-size: var(--text-small);
    text-align: center;
    color: var(--color-text-dim);
  }

  /* Result reveal: keyed to the [data-scene] attribute (not the bare class)
     so the entrance replays every time the scene becomes active again --
     these scenes can be revisited (another black hole, another comparison),
     unlike the hero's one-shot title-reveal. A short, staggered fade+rise,
     never a bounce, so the sequence reads as "revealed in order" rather than
     drawing attention to the motion itself. The outcome/comparison portrait
     gets its own tidal-settle keyframe instead -- a brief vertical
     overshoot-and-settle that nods at spaghettification without literally
     re-animating the stretch. */
  .experience[data-scene="outcome"] .outcome-image {
    animation: tidal-settle 0.55s var(--ease-standard) both;
  }

  .experience[data-scene="outcome"] .outcome-headline {
    animation: result-reveal 0.55s var(--ease-standard) 0.08s both;
  }

  .experience[data-scene="outcome"] .outcome-stats {
    animation: result-reveal 0.55s var(--ease-standard) 0.16s both;
  }

  .experience[data-scene="outcome"] .outcome-reveal {
    animation: result-reveal 0.55s var(--ease-standard) 0.26s both;
  }

  .experience[data-scene="comparison"] .comparison-side-stellar .comparison-image {
    animation: tidal-settle 0.55s var(--ease-standard) both;
  }

  .experience[data-scene="comparison"] .comparison-side-supermassive .comparison-image {
    animation: tidal-settle 0.55s var(--ease-standard) 0.12s both;
  }

  .experience[data-scene="comparison"] .comparison-chart {
    animation: result-reveal 0.55s var(--ease-standard) 0.2s both;
  }

  .experience[data-scene="comparison"] .comparison-conclusion {
    animation: result-reveal 0.55s var(--ease-standard) 0.3s both;
  }

  .experience[data-scene="comparison"] .comparison-detail-line {
    animation: result-reveal 0.55s var(--ease-standard) 0.38s both;
  }

  @keyframes horizon-plunge-mobile {
    0% {
      opacity: 0.98;
      transform: translate(-50%, -50%) scale(1.46);
      filter: saturate(1.45) brightness(0.82);
    }

    34% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.9);
      filter: saturate(1.8) brightness(1.16);
    }

    70% {
      opacity: 0.72;
      transform: translate(-50%, -50%) scale(3.3);
      filter: saturate(1.15) brightness(0.68) blur(2px);
    }

    100% {
      opacity: 0.14;
      transform: translate(-50%, -50%) scale(6);
      filter: saturate(0.45) brightness(0.18) blur(8px);
    }
  }

  @keyframes lookback-arrive {
    0% {
      opacity: 0;
      transform: scale(1.32) translateX(16%) rotate(3deg);
      filter: blur(20px) saturate(0.45) brightness(1.4);
    }

    48% {
      opacity: 0.45;
      filter: blur(10px) saturate(1.25) brightness(1.12);
    }

    100% {
      opacity: 1;
      transform: scale(calc(1 + var(--fall-lensing, 0) * 0.6))
        translateX(calc(var(--fall-lensing, 0) * -8%));
      filter: blur(calc(var(--fall-lensing, 0) * 2px)) saturate(calc(1 + var(--fall-lensing, 0) * 0.5));
    }
  }

  @keyframes horizon-plunge {
    0% {
      opacity: 0.98;
      transform: scale(1.57) rotate(2deg);
      filter: saturate(1.45) brightness(0.82);
    }

    34% {
      opacity: 1;
      transform: scale(1.92) rotate(3deg);
      filter: saturate(1.8) brightness(1.16);
    }

    70% {
      opacity: 0.72;
      transform: scale(3.4) rotate(5deg);
      filter: saturate(1.15) brightness(0.68) blur(2px);
    }

    100% {
      opacity: 0.14;
      transform: scale(6.2) rotate(7deg);
      filter: saturate(0.45) brightness(0.18) blur(8px);
    }
  }

  /* The veil collapses inward instead of growing outward, and never drops below
     scale(1). Its gradient is opaque #000 past 72%, so any scale under 1 leaves
     the element's own box corners painting a hard-edged rectangle across the
     frame -- clearly visible mid-plunge. Ending on scale(1) also matches the
     [data-horizon="crossed"] rule below, so the animation hands over without a
     jump. */
  @keyframes horizon-engulf {
    0% {
      opacity: 0;
      transform: scale(2.8);
    }

    36% {
      opacity: 0.35;
      transform: scale(2.1);
    }

    72% {
      opacity: 0.85;
      transform: scale(1.35);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes void-flare {
    0%,
    28% {
      opacity: 1;
      filter: brightness(1);
    }

    48% {
      opacity: 1;
      filter: brightness(2.15);
    }

    82% {
      opacity: 0.3;
      filter: brightness(0.4);
    }

    100% {
      opacity: 0.08;
      filter: brightness(0.18);
    }
  }

  @keyframes camera-turn-veil {
    0% {
      opacity: 0;
      transform: translateX(-45%) skewX(-10deg);
    }

    46% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(55%) skewX(-10deg);
    }
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.04) translate(0, 0);
    }

    to {
      transform: scale(1.08) translate(-1%, -1%);
    }
  }

  @keyframes glow-pulse {
    0%,
    100% {
      opacity: 0.5;
    }

    50% {
      opacity: 0.9;
    }
  }

  @keyframes split-reveal {
    from {
      transform: scaleY(0);
      opacity: 0;
    }

    to {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @keyframes atmosphere-drift {
    from {
      transform: translate(0, 0);
    }

    to {
      transform: translate(-1%, 1%);
    }
  }

  @keyframes title-reveal {
    from {
      opacity: 0;
      transform: scale(0.9);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 rgb(79 209 255 / 0%);
    }

    50% {
      box-shadow: var(--glow-you);
    }
  }

  @keyframes clock-snap {
    0% {
      transform: scale(1);
      text-shadow: none;
    }

    40% {
      transform: scale(1.15);
      text-shadow: var(--glow-soft);
    }

    100% {
      transform: scale(1);
      text-shadow: none;
    }
  }

  @keyframes connector-pulse {
    0% {
      left: 0;
      opacity: 1;
    }

    100% {
      left: calc(100% - 10px);
      opacity: 0;
    }
  }

  @keyframes result-reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes tidal-settle {
    from {
      opacity: 0;
      transform: scaleY(1.08) translateY(8px);
    }

    to {
      opacity: 1;
      transform: scaleY(1) translateY(0);
    }
  }

  @media (max-width: 40rem) {
    .layer-hud {
      padding: var(--space-md) var(--space-sm) var(--space-md);
    }

    .duality-labels {
      top: var(--space-lg);
      transform: none;
      padding: 0 var(--space-md);
    }

    .hero-narrative {
      font-size: var(--text-small);
      line-height: 1.6;
    }

    .scene {
      gap: var(--space-sm);
      padding: var(--space-xl) var(--space-sm) var(--space-lg);
    }

    .hero-cta {
      flex-direction: column;
      width: 100%;
      gap: var(--space-2xs);
    }

    .hero-cta .btn {
      width: 100%;
      justify-content: center;
    }

    .btn {
      padding: var(--space-sm) var(--space-md);
      min-height: 2.75rem;
    }

    .blackhole-options {
      flex-direction: column;
      align-items: center;
      gap: var(--space-md);
    }

    /* Sync/fall stages stay side-by-side (per the mobile reference mockup)
       rather than stacking -- density comes from hiding decorative art and
       shrinking the connector, not from collapsing to one column. */
    .sync-stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: var(--space-2xs);
      max-width: 100%;
    }

    .sync-side {
      padding: var(--space-sm) var(--space-xs);
    }

    .sync-astronaut-arm {
      display: none;
    }

    .sync-connector {
      width: 1.25rem;
      height: 2px;
    }

    /* The cockpit still must not scroll at 390x844, so the rails condense to a
       side-by-side pair above the void rather than the desktop's left/right
       columns. */
    .scene-falling {
      grid-template-areas:
        "header header"
        "you    earth"
        "centre centre"
        "foot   foot";
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      padding: 4rem var(--space-sm) var(--space-2xs);
    }

    .scene-falling > .scene-hint {
      margin-top: 1.2rem;
      font-size: 0.65rem;
      letter-spacing: 0.02em;
    }

    .scene-falling > .viewpoint-control {
      margin-top: 2.85rem;
    }

    .fall-side {
      padding: 0.4rem 0.65rem;
