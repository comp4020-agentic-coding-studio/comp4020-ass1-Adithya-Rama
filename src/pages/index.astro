---
import "../styles/global.css";
import "../styles/button.css";
import Starfield from "../components/Starfield.astro";
import PrimaryNav from "../components/PrimaryNav.astro";
import BlackHoleOption from "../components/BlackHoleOption.astro";
import { withBase } from "../lib/base";

const stellarStats = [
  { label: "Conceptual mass", value: "~10 solar masses" },
  { label: "Approximate event horizon scale", value: "~30 km" },
  { label: "Tidal forces at horizon", value: "Extreme" },
  { label: "Likelihood of surviving horizon crossing", value: "Very poor" },
];

const supermassiveStats = [
  { label: "Conceptual mass", value: "millions of solar masses" },
  { label: "Event horizon", value: "vast" },
  { label: "Tidal forces at horizon", value: "much milder" },
  { label: "Likelihood of crossing the horizon intact", value: "possible" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FALL — One journey. Two realities.</title>
    <meta
      name="description"
      content="An interactive explainer of gravitational time dilation: an infalling astronaut and a distant Earth observer share one event and never agree on how long it took."
    />
  </head>
  <body>
    <div class="experience" data-scene="hero" data-testid="interaction-output">
      <div class="layer layer-bg"></div>
      <div class="layer layer-atmosphere">
        <Starfield />
      </div>
      <div class="layer layer-scene">
        <img
          class="hero-image"
          src={withBase("img/blackhole-split-earth.webp")}
          alt="A black hole splitting starlight into a cyan stream on one side and an amber stream on the other, with Earth visible in the distance"
          fetchpriority="high"
        />
        <div class="gravity-glow" aria-hidden="true"></div>
        <div class="split-line" aria-hidden="true"></div>
        <div class="lensing-vignette" aria-hidden="true"></div>
      </div>

      <PrimaryNav />

      <div class="duality-labels" aria-hidden="true">
        <span class="duality-label duality-label-you">You</span>
        <span class="duality-label duality-label-earth">Earth observer</span>
      </div>

      <main class="layer layer-hud">
        <section class="scene scene-hero">
          <header class="hero-copy">
            <h1 class="hero-title">FALL</h1>
            <p class="hero-tagline">One journey. Two realities.</p>
            <p class="hero-narrative">
              You and Earth synchronise your clocks.<br />
              You fall into a black hole.<br />
              You will never agree on what happens next.
            </p>
          </header>

          <div class="hero-cta">
            <button type="button" class="btn btn-primary btn-pulse" data-testid="interaction">
              Begin fall
            </button>
          </div>
        </section>

        <section class="scene scene-selecting" aria-hidden="true" inert>
          <h2>Choose your black hole</h2>
          <p class="scene-question">Which one is safer to fall into?</p>
          <p class="scene-hint">Hover, focus, or select each to compare.</p>

          <fieldset class="blackhole-choice">
            <legend class="visually-hidden">Select a black hole to fall into</legend>
            <div class="blackhole-options">
              <BlackHoleOption
                value="stellar"
                name="blackhole"
                image="img/blackhole-stellar.webp"
                alt="A tilted blue accretion disk representing a stellar-mass black hole"
                title="Stellar black hole"
                stats={stellarStats}
              />
              <BlackHoleOption
                value="supermassive"
                name="blackhole"
                image="img/blackhole-supermassive.webp"
                alt="A tilted amber accretion disk representing a supermassive black hole"
                title="Supermassive black hole"
                stats={supermassiveStats}
              />
            </div>
          </fieldset>

          <div class="hero-cta">
            <button
              type="button"
              class="btn btn-primary"
              id="start-descent"
              data-testid="start-descent"
              disabled
            >
              Start descent
            </button>
          </div>
        </section>

        <section class="scene scene-syncing" aria-hidden="true" inert>
          <h2>Synchronise your clocks</h2>
          <p class="scene-selecting-meta" id="descent-summary"></p>

          <div class="sync-stage">
            <div class="sync-side sync-side-you">
              <img
                class="sync-astronaut-arm"
                src={withBase("img/astronaut-glove.webp")}
                alt=""
                aria-hidden="true"
                loading="lazy"
              />
              <span class="sync-label">You</span>
              <span class="sync-clock" id="clock-you">--:--:--</span>
            </div>

            <div class="sync-connector" aria-hidden="true">
              <span class="sync-connector-line"></span>
              <span class="sync-connector-pulse"></span>
            </div>

            <div class="sync-side sync-side-earth">
              <span class="sync-label">Earth observer</span>
              <span class="sync-clock" id="clock-earth">--:--:--</span>
            </div>
          </div>

          <p class="visually-hidden" aria-live="polite" id="sync-status"></p>

          <div class="hero-cta">
            <button type="button" class="btn btn-primary" id="sync-clocks" data-testid="sync-clocks">
              Sync clocks
            </button>
            <button
              type="button"
              class="btn btn-primary"
              id="begin-descent"
              data-testid="begin-descent"
              hidden
            >
              Begin descent
            </button>
          </div>
        </section>

        <section class="scene scene-falling" aria-hidden="true" inert>
          <h2>Falling</h2>
          <p class="scene-hint" id="fall-hint">
            Hold the control below, or hold Arrow Down / S, to descend. Release to hold your
            position.
          </p>

          <div class="fall-stage">
            <div class="fall-side fall-side-you">
              <img
                class="fall-hand"
                src={withBase("img/astronaut-glove.webp")}
                alt=""
                aria-hidden="true"
                loading="lazy"
              />
              <span class="sync-label">You</span>
              <span class="fall-clock" id="fall-clock-you">00:00:00</span>
              <p class="fall-readout" id="fall-readout-you">Distance to horizon: 100%</p>
            </div>

            <div class="fall-side fall-side-earth">
              <img
                class="fall-astronaut"
                src={withBase("img/astronaut-reach-cool.webp")}
                alt=""
                aria-hidden="true"
                loading="lazy"
              />
              <span class="sync-label">Earth observer</span>
              <span class="fall-clock" id="fall-clock-earth">00:00:00</span>
              <p class="fall-readout" id="fall-readout-earth">Signal: strong</p>
            </div>
          </div>

          <p class="fall-caption" id="fall-caption">Redshift ×1.0 · Tidal stress: mild</p>

          <ol class="fall-timeline" aria-label="Fall stage">
            <li class="fall-timeline-step is-active" data-stage="approach" aria-current="step">
              Approach
            </li>
            <li class="fall-timeline-step" data-stage="horizon">Horizon</li>
            <li class="fall-timeline-step" data-stage="interior">Interior / Tidal outcome</li>
          </ol>

          <p class="visually-hidden" aria-live="polite" id="fall-status"></p>

          <div class="hero-cta">
            <button
              type="button"
              class="btn btn-primary"
              id="descend-control"
              data-testid="descend-control"
              aria-describedby="fall-hint"
              aria-pressed="false"
            >
              Hold to descend
            </button>
          </div>
        </section>
      </main>
    </div>

    <script>
      import "../scripts/experience";
    </script>
  </body>
</html>

<style>
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    animation: hero-drift 50s ease-in-out infinite alternate;
  }

  .gravity-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, rgb(255 255 255 / 20%), transparent 35%);
    mix-blend-mode: screen;
    animation: glow-pulse 6s ease-in-out infinite;
  }

  .split-line {
    position: absolute;
    top: 10%;
    bottom: 10%;
    left: 50%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgb(255 255 255 / 35%), transparent);
    transform: scaleY(0);
    transform-origin: center;
    animation: split-reveal 1.6s var(--ease-standard) 0.4s both;
  }

  .layer-atmosphere {
    animation: atmosphere-drift 90s linear infinite alternate;
  }

  .duality-labels {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    z-index: var(--z-overlay);
    display: flex;
    justify-content: space-between;
    padding: 0 var(--space-lg);
    pointer-events: none;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .duality-label {
    font-size: var(--text-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .duality-label-you {
    color: var(--color-you);
    text-shadow: 0 0 12px var(--color-you-dim);
  }

  .duality-label-earth {
    color: var(--color-earth);
    text-shadow: 0 0 12px var(--color-earth-dim);
  }

  /* the duality labels sit at vertical center, which is exactly where the
     later scenes place their own content -- fade them out once we've moved
     past the hero rather than let them collide. */
  .experience:not([data-scene="hero"]) .duality-labels {
    opacity: 0;
  }

  .layer-hud {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-2xl) var(--space-md) var(--space-xl);
    text-align: center;
  }

  .scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    padding: var(--space-2xl) var(--space-md);
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-slow) var(--ease-standard);
  }

  .experience[data-scene="hero"] .scene-hero,
  .experience[data-scene="selecting"] .scene-selecting,
  .experience[data-scene="syncing"] .scene-syncing,
  .experience[data-scene="falling"] .scene-falling {
    opacity: 1;
    pointer-events: auto;
  }

  .blackhole-choice {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    width: 100%;
    max-width: 44rem;
  }

  .blackhole-options {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
  }

  .scene-question {
    margin: 0;
    font-size: var(--text-h2);
    color: var(--color-text);
    font-weight: 600;
  }

  .scene-hint {
    margin: calc(var(--space-xs) * -1) 0 0;
    font-size: var(--text-small);
    color: var(--color-text-faint);
  }

  .hero-title {
    margin: 0;
    font-size: var(--text-hero);
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--color-text);
    text-shadow: var(--glow-soft);
    animation: title-reveal 1.4s var(--ease-standard) both;
  }

  .hero-tagline {
    margin: var(--space-xs) 0 0;
    font-size: var(--text-body);
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
  }

  .hero-narrative {
    margin: var(--space-md) 0 0;
    font-size: var(--text-small);
    color: var(--color-text-faint);
    line-height: 1.8;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
  }

  .btn-pulse {
    animation: cta-pulse 2.4s ease-in-out infinite;
  }

  .scene-selecting h2 {
    margin: 0;
    font-size: var(--text-h2);
    color: var(--color-text);
    font-weight: 600;
  }

  .scene-selecting-meta {
    margin: 0;
    color: var(--color-text-dim);
    font-size: var(--text-small);
  }

  .sync-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    width: 100%;
    max-width: 48rem;
  }

  .sync-side {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
  }

  .sync-label {
    font-size: var(--text-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .sync-side-you .sync-label {
    color: var(--color-you);
  }

  .sync-side-earth .sync-label {
    color: var(--color-earth);
  }

  .sync-clock {
    font-family: var(--font-mono);
    font-size: var(--text-h2);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }

  .sync-stage.synced .sync-clock {
    animation: clock-snap 0.6s var(--ease-standard);
  }

  .sync-astronaut-arm {
    position: absolute;
    bottom: -2.5rem;
    width: 6rem;
    opacity: 0.35;
    pointer-events: none;
  }

  .sync-connector {
    position: relative;
    flex: 0 0 auto;
    width: 5rem;
    height: 2px;
  }

  .sync-connector-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--color-you-dim), var(--color-earth-dim));
    opacity: 0.4;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .sync-stage.synced .sync-connector-line {
    opacity: 1;
  }

  .sync-connector-pulse {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--color-text);
    box-shadow: var(--glow-soft);
    opacity: 0;
  }

  .sync-stage.synced .sync-connector-pulse {
    animation: connector-pulse 0.9s var(--ease-standard);
  }

  /* the lensing vignette lives on the persistent background layer, so its
     intensity (set on .experience via --fall-lensing) reaches it by plain
     custom-property inheritance -- no per-scene wiring needed. */
  .lensing-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, transparent 30%, rgb(0 0 0 / 70%) 100%);
    opacity: 0;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .experience[data-scene="falling"] .lensing-vignette {
    opacity: var(--fall-lensing, 0);
  }

  .experience[data-scene="falling"] .gravity-glow {
    transform: scale(calc(1 + var(--fall-lensing, 0) * 0.4));
    transition: transform var(--duration-medium) var(--ease-standard);
  }

  .fall-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    width: 100%;
    max-width: 48rem;
  }

  .fall-side {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
  }

  .fall-side-you .sync-label {
    color: var(--color-you);
  }

  .fall-side-earth .sync-label {
    color: var(--color-earth);
  }

  .fall-clock {
    font-family: var(--font-mono);
    font-size: var(--text-h2);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }

  .fall-readout {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-dim);
  }

  .fall-hand {
    width: 5rem;
    opacity: 0.4;
    pointer-events: none;
    transform: scale(calc(1 + var(--fall-lensing, 0) * 0.15));
    transition: transform var(--duration-medium) var(--ease-standard);
  }

  .fall-astronaut {
    width: 6rem;
    border-radius: var(--radius-md);
    opacity: var(--fall-brightness, 1);
    filter: sepia(var(--fall-warmth, 0)) blur(var(--fall-motion-blur, 0px));
    transition:
      opacity var(--duration-medium) var(--ease-standard),
      filter var(--duration-medium) var(--ease-standard);
  }

  .fall-caption {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-faint);
  }

  .fall-timeline {
    display: flex;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .fall-timeline-step {
    position: relative;
    padding-left: var(--space-sm);
  }

  .fall-timeline-step::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 6px;
    height: 6px;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--color-text-faint);
  }

  .fall-timeline-step.is-active {
    color: var(--color-text);
  }

  .fall-timeline-step.is-active::before {
    background: var(--color-you);
    box-shadow: var(--glow-you);
  }

  .fall-timeline-step.is-complete {
    color: var(--color-text-dim);
  }

  .fall-timeline-step.is-complete::before {
    background: var(--color-you-dim);
  }

  #descend-control {
    touch-action: none;
  }

  #descend-control[aria-pressed="true"] {
    background: var(--color-you-dim);
    box-shadow: var(--glow-you);
  }

  @keyframes hero-drift {
    from {
      transform: scale(1.04) translate(0, 0);
    }

    to {
      transform: scale(1.08) translate(-1%, -1%);
    }
  }

  @keyframes glow-pulse {
    0%,
    100% {
      opacity: 0.5;
    }

    50% {
      opacity: 0.9;
    }
  }

  @keyframes split-reveal {
    from {
      transform: scaleY(0);
      opacity: 0;
    }

    to {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @keyframes atmosphere-drift {
    from {
      transform: translate(0, 0);
    }

    to {
      transform: translate(-1%, 1%);
    }
  }

  @keyframes title-reveal {
    from {
      opacity: 0;
      transform: scale(0.9);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes cta-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 rgb(79 209 255 / 0%);
    }

    50% {
      box-shadow: var(--glow-you);
    }
  }

  @keyframes clock-snap {
    0% {
      transform: scale(1);
      text-shadow: none;
    }

    40% {
      transform: scale(1.15);
      text-shadow: var(--glow-soft);
    }

    100% {
      transform: scale(1);
      text-shadow: none;
    }
  }

  @keyframes connector-pulse {
    0% {
      left: 0;
      opacity: 1;
    }

    100% {
      left: calc(100% - 10px);
      opacity: 0;
    }
  }

  @keyframes connector-pulse-vertical {
    0% {
      top: 0;
      opacity: 1;
    }

    100% {
      top: calc(100% - 10px);
      opacity: 0;
    }
  }

  @media (max-width: 40rem) {
    .layer-hud {
      padding: var(--space-lg) var(--space-sm) var(--space-lg);
    }

    .duality-labels {
      top: var(--space-2xl);
      transform: none;
      padding: 0 var(--space-md);
    }

    .hero-narrative {
      font-size: var(--text-small);
    }

    .scene {
      gap: var(--space-md);
      padding: var(--space-xl) var(--space-sm);
    }

    .blackhole-options {
      flex-direction: column;
      align-items: center;
      gap: var(--space-md);
    }

    .sync-stage {
      flex-direction: column;
      gap: var(--space-md);
    }

    .sync-astronaut-arm {
      bottom: -1.5rem;
      width: 4rem;
    }

    .sync-connector {
      width: 2px;
      height: 3rem;
    }

    .sync-connector-line {
      background: linear-gradient(to bottom, var(--color-you-dim), var(--color-earth-dim));
    }

    .sync-connector-pulse {
      top: 0;
      left: 50%;
      margin-top: 0;
      margin-left: -5px;
    }

    .sync-stage.synced .sync-connector-pulse {
      animation-name: connector-pulse-vertical;
    }

    .fall-stage {
      flex-direction: column;
      gap: var(--space-md);
    }

    .fall-hand {
      width: 3.5rem;
    }

    .fall-astronaut {
      width: 4.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image,
    .gravity-glow,
    .layer-atmosphere,
    .hero-title,
    .split-line,
    .btn-pulse,
    .sync-clock,
    .sync-connector-pulse {
      animation: none;
    }

    .hero-title,
    .split-line {
      opacity: 1;
      transform: none;
    }

    .gravity-glow {
      opacity: 0.7;
    }
  }
</style>
