---
import { withBase } from "../lib/base";

interface Stat {
  label: string;
  value: string;
}

interface Props {
  value: "stellar" | "supermassive";
  name: string;
  image: string;
  alt: string;
  title: string;
  stats: Stat[];
}

const { value, name, image, alt, title, stats } = Astro.props;
const id = `blackhole-${value}`;
const statsId = `${id}-stats`;
---

<label class={`blackhole-option blackhole-option-${value}`} for={id}>
  <input
    type="radio"
    name={name}
    id={id}
    value={value}
    class="blackhole-option-input"
    aria-label={title}
    aria-describedby={statsId}
  />
  <span class="blackhole-option-card">
    <img class="blackhole-option-image" src={withBase(image)} alt={alt} loading="lazy" decoding="async" />
    <span class="blackhole-option-name">{title}</span>
    <dl class="blackhole-option-stats" id={statsId}>
      {
        stats.map((stat) => (
          <div class="blackhole-option-stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </span>
</label>

<style>
  .blackhole-option {
    position: relative;
    display: block;
    flex: 1 1 14rem;
    max-width: 18rem;
    cursor: pointer;
  }

  .blackhole-option-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .blackhole-option-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    border: var(--border-hairline);
    background: var(--surface-glass-bg);
    backdrop-filter: blur(var(--surface-glass-blur));
    transition:
      transform var(--duration-medium) var(--ease-standard),
      box-shadow var(--duration-medium) var(--ease-standard),
      border-color var(--duration-medium) var(--ease-standard);
  }

  .blackhole-option-image {
    width: 100%;
    max-width: 12rem;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    transition:
      transform var(--duration-medium) var(--ease-standard),
      filter var(--duration-medium) var(--ease-standard);
  }

  .blackhole-option-name {
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .blackhole-option-stats {
    display: grid;
    gap: var(--space-3xs);
    margin: 0;
    width: 100%;
    font-size: var(--text-small);
    opacity: 0.5;
    max-height: 3.2em;
    overflow: hidden;
    transition:
      opacity var(--duration-medium) var(--ease-standard),
      max-height var(--duration-medium) var(--ease-standard);
  }

  .blackhole-option-stat {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .blackhole-option-stat dt {
    margin: 0;
    color: var(--color-text-faint);
  }

  .blackhole-option-stat dd {
    margin: 0;
    color: var(--color-text);
    text-align: right;
  }

  .blackhole-option:hover .blackhole-option-stats,
  .blackhole-option:focus-within .blackhole-option-stats,
  .blackhole-option-input:checked ~ .blackhole-option-card .blackhole-option-stats {
    opacity: 1;
    max-height: 12rem;
  }

  .blackhole-option:hover .blackhole-option-image,
  .blackhole-option:focus-within .blackhole-option-image,
  .blackhole-option-input:checked ~ .blackhole-option-card .blackhole-option-image {
    transform: scale(1.05);
    filter: brightness(1.15);
  }

  .blackhole-option-input:checked ~ .blackhole-option-card {
    transform: translateY(-4px) scale(1.02);
  }

  .blackhole-option-input:focus-visible ~ .blackhole-option-card {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }

  .blackhole-option-stellar:hover .blackhole-option-card,
  .blackhole-option-stellar .blackhole-option-input:checked ~ .blackhole-option-card {
    border-color: var(--color-you-dim);
    box-shadow: var(--glow-you);
  }

  .blackhole-option-supermassive:hover .blackhole-option-card,
  .blackhole-option-supermassive .blackhole-option-input:checked ~ .blackhole-option-card {
    border-color: var(--color-earth-dim);
    box-shadow: var(--glow-earth);
  }
</style>
